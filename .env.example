# ---------------------------------------------------------------------------
# VaultNode DEV-ONLY configuration. Copy to .env for local Docker runs.
#
# These keys are PUBLIC and FAKE: each one hex-decodes to the ASCII text
# "DEV-ONLY-...-DO-NOT-USE". They are used by the test vectors in
# docs/PROTOCOL.md §6. Never use them anywhere real.
#
# Real deployments do not keep MASTER_KEY in an env var: it lives in a secure
# element / TPM, and per-badge key diversification happens inside it.
# Generate real keys with: openssl rand -hex 32
# ---------------------------------------------------------------------------
VAULTNODE_ID=vn-01
MASTER_KEY_HEX=4445562d4f4e4c592d4d41535445522d4b45592d444f2d4e4f542d5553452121
COMMAND_KEY_HEX=4445562d4f4e4c592d434f4d4d414e442d4b45592d444f4e4f54555345212121
TELEMETRY_KEY_HEX=4445562d4f4e4c592d54454c454d455452592d4b45592d444f4e4f5455534521
MQTT_HOST=mosquitto
MQTT_PORT=1883
